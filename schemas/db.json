{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbrtn.net/schemas/spacecraft-database.schema.json",
  "title": "Database of spacecraft static metadata",
  "description": "Spacecrafts database schema",
  "type": "object",
  "properties": {
    "version": {
      "description": "Database version",
      "type": "string"
    },
    "gitSha": {
      "type": "string"
    },
    "generated": {
      "description": "Timestamp the database was generated",
      "type": "string",
      "format": "date-time"
    },
    "spacecrafts": {
      "description": "Supported known spacecrafts",
      "type": "array",
      "items": {
        "$ref": "#/$defs/spacecraft"
      }
    }
  },
  "required": [
    "version",
    "gitSha",
    "generated",
    "spacecrafts"
  ],
  "$defs": {
    "link": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "documentation",
            "other",
            "webpage"
          ]
        },
        "description": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "href"
      ]
    },
    "spacecraft": {
      "description": "Spacecraft data",
      "type": "object",
      "properties": {
        "scid": {
          "description": "Spacecraft identifier; see https://sanaregistry.org/r/spacecraftid",
          "type": "integer"
        },
        "name": {
          "description": "Spacecraft non-canonical name. May not be unique",
          "type": "string"
        },
        "links": {
          "description": "Links related to this spacecraft, e.g., ICD or Space to Ground docs",
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "aliases": {
          "description": "Spacecraft alias names",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noradCatalogID": {
          "description": "NORAD catalog identifier",
          "type": "integer"
        },
        "framing": {
          "$ref": "#/$defs/framingConfig"
        },
        "vcids": {
          "description": "List of available virtual channels",
          "type": "array",
          "items": {
            "$ref": "#/$defs/virtualChannel"
          }
        },
        "timecodes": {
          "description": "Timecode configurations",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/timecode"
          }
        },
        "apids": {
          "description": "Application identifiers",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "apid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              },
              "vcid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              },
              "sensor": {
                "description": "Sensor this APID is for, if any",
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "timecode": {
                "type": "string",
                "description": "Name of timecode configuration from global configuration"
              }
            },
            "required": [
              "apid",
              "vcid"
            ]
          }
        }
      },
      "required": [
        "scid",
        "framing",
        "vcids",
        "apids"
      ]
    },
    "framingConfig": {
      "description": "Spacecraft downlink framing parameters necessary to decode",
      "type": "object",
      "properties": {
        "length": {
          "description": "Length of the frame, i.e. no ASM or RS parity bytes",
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "description": "Type of the frame",
          "type": "string",
          "enum": [
            "ccsds_aos",
            "ccsds_tm",
            "unknown"
          ]
        },
        "insertZoneLength": {
          "description": "Number of bytes in the insert zone",
          "type": "integer",
          "minimum": 0
        },
        "trailerLength": {
          "description": "Number of bytes in the frame trailer. To be used if not specified for the vcid.",
          "type": "integer",
          "minimum": 0
        },
        "ocfPresent": {
          "description": "If true the 4 byte OCF field is present at the end of each frame",
          "type": "boolean"
        },
        "pseudoNoise": {
          "description": "Pseudo noise configuration. Non-nil value indicates standard CCSDS PN.",
          "type": "object",
          "const": {}
        },
        "reedSolomon": {
          "description": "Reed-solomon forward-error correction config",
          "type": "object",
          "properties": {
            "interleave": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "virtualFillLength": {
              "description": "Number of bytes of virtual fill necessary",
              "type": "integer",
              "minimum": 0
            },
            "numCorrectable": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "length",
        "type"
      ]
    },
    "virtualChannel": {
      "description": "Spacecraft virtual channel",
      "type": "object",
      "properties": {
        "vcid": {
          "description": "Virtual channel id",
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "framing": {
          "description": "Virtual channel specifc framing configuration",
          "type": "object",
          "properties": {
            "trailerLength": {
              "description": "Number of bytes in the frame trailer. To be used if not specified for the vcid.",
              "type": "integer",
              "minimum": 0
            },
            "ocfPresent": {
              "description": "If true the 4 byte OCF field is present at the end of each frame",
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "vcid"
      ]
    },
    "timecode": {
      "description": "Timecode configuration for implied (non-self-identifying) packets where the p-field is not present in the bit stream.",
      "type": "object",
      "properties": {},
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "cds"
            },
            "epoch": {
              "description": "Epoch time (UTC) for timestamp calculations.",
              "type": "string",
              "format": "date-time"
            },
            "dayLength": {
              "description": "number of bytes for day component",
              "type": "integer",
              "enum": [
                2,
                3
              ]
            },
            "submillisLength": {
              "description": "number of bytes for the submillis component",
              "type": "integer",
              "enum": [
                0,
                2,
                4
              ]
            },
            "selfIdentifying": {
              "description": "Pfield is present in the data stream",
              "type": "boolean"
            }
          },
          "required": [
            "epoch",
            "format",
            "dayLength",
            "submillisLength"
          ]
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "const": "cuc"
            },
            "epoch": {
              "description": "Epoch time (TAI) for timestamp calculations",
              "type": "string",
              "format": "date-time"
            },
            "basicLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Number of bytes for the basic time component"
            },
            "fineNanos": {
              "type": "number",
              "minimum": 1,
              "description": "Number of nanoseconds each for each fine time count"
            },
            "fineLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8,
              "description": "Number of bytes for the fine time component"
            },
            "selfIdentifying": {
              "description": "Pfield is present in the data stream",
              "type": "boolean"
            }
          },
          "required": [
            "format",
            "epoch",
            "basicLength",
            "fineLength"
          ]
        }
      ],
      "required": [
        "format"
      ]
    }
  }
}
